amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["prettier"] = Builtins.prettier

    ["codex-pane-label"] {
        glob = List("dot_codex/*herdr-codex-account*", "dot_codex/modify_hooks.json", "dot_zshrc.tmpl", "dot_local/bin/executable_codex-usage", "scripts/test-herdr-codex-account.py")
        check = "python3 scripts/test-herdr-codex-account.py"
    }

    ["worktrunk"] {
        glob = List("dot_config/worktrunk/**", "dot_config/herdr/config.toml.tmpl", "dot_config/herdr/plugins/config/worktrunk/**", "dot_config/herdr/scripts/*.py", "dot_config/herdr/scripts/*worktree*", "dot_config/herdr/scripts/*lazygit*", "dot_config/herdr/scripts/*update-plugins*", "dot_local/bin/*herdr-worktrees", "dot_agents/skills/poteto-mode/scripts/*worktree*", ".chezmoiscripts/*claude-worktrunk*", ".chezmoiscripts/*codex-worktrunk*", ".chezmoiscripts/*herdr-plugins*", "dot_codex*/modify_private_config.toml", "scripts/*worktrunk*", "scripts/update-herdr-plugins.py", "scripts/test-worktree-audit.py", "scripts/test-codex-config.py", "mise.toml", "hk.pkl")
        check = "mise run check-worktrunk"
    }

    ["pkl"] {
        glob = "*.pkl"
        check = "pkl eval {{files}} >/dev/null"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
