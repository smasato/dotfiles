{{- /* chezmoi:modify-template */ -}}
{{- $lastChangelogVersion := "0.84.1" -}}
{{- if .chezmoi.stdin }}
{{-   with fromJson .chezmoi.stdin }}
{{-     with .lastChangelogVersion }}{{ $lastChangelogVersion = . }}{{ end }}
{{-   end }}
{{- end -}}
{
  "lastChangelogVersion": {{ $lastChangelogVersion | toJson }},
  "theme": "catppuccin-mocha",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "showHardwareCursor": true,
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "collapseChangelog": true,
  "defaultProjectTrust": "ask",
  "externalEditor": "nvim",
  "autocompleteMaxVisible": 10,
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    "npm:@firstpick/pi-themes-bundle"
  ]
}