{{- /* chezmoi:modify-template */ -}}
{{- /* hooks.json is also written by herdr, moshi-hook, and orca, so only the
herdr-codex-account.sh entries (SessionStart for resume / restore, Stop so the
quota in the pane border refreshes after every turn) are merged in; everything
else passes through untouched. Entries are appended (never inserted) because
Codex keys hook trust hashes by array index in each home's config.toml
[hooks.state]. */ -}}
{{- $cmd := printf "sh '%s/.codex/herdr-codex-account.sh'" .chezmoi.homeDir -}}
{{- $entry := dict "hooks" (list (dict "type" "command" "command" $cmd "timeout" 5)) -}}
{{- $cur := dict -}}
{{- if .chezmoi.stdin }}{{ $cur = fromJson .chezmoi.stdin }}{{ end -}}
{{- $hooks := default (dict) (get $cur "hooks") -}}
{{- $changed := false -}}
{{- range $event := list "SessionStart" "Stop" -}}
{{-   $entries := default (list) (get $hooks $event) -}}
{{-   $found := false -}}
{{-   range $entries -}}
{{-     range (default (list) (get . "hooks")) -}}
{{-       if eq (get . "command") $cmd }}{{ $found = true }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{-   if not $found -}}
{{-     $_ := set $hooks $event (append $entries $entry) -}}
{{-     $changed = true -}}
{{-   end -}}
{{- end -}}
{{- if $changed -}}
{{- $_ := set $cur "hooks" $hooks -}}
{{- toPrettyJson $cur }}
{{ else -}}
{{- .chezmoi.stdin -}}
{{- end -}}
