{{- /* chezmoi:modify-template */ -}}
{{- /* hooks.json is also written by herdr, moshi-hook, and orca, so only the
herdr-codex-account.sh entries are updated in place; everything else passes
through untouched. Codex owns the async SessionStart/Stop work and cancels it
on exit; SessionEnd only clears metadata. Entries are appended (never inserted) because
Codex keys hook trust hashes by array index in each home's config.toml
[hooks.state]. */ -}}
{{- $cmd := printf "sh '%s/.codex/herdr-codex-account.sh'" .chezmoi.homeDir -}}
{{- $cur := dict -}}
{{- if .chezmoi.stdin }}{{ $cur = fromJson .chezmoi.stdin }}{{ end -}}
{{- $hooks := default (dict) (get $cur "hooks") -}}
{{- $changed := false -}}
{{- range $event := list "SessionStart" "Stop" "SessionEnd" -}}
{{-   $async := ne $event "SessionEnd" -}}
{{-   $timeout := 25 -}}
{{-   if not $async }}{{ $timeout = 3 }}{{ end -}}
{{-   $entry := dict "hooks" (list (dict "type" "command" "command" $cmd "timeout" $timeout "async" $async)) -}}
{{-   $entries := default (list) (get $hooks $event) -}}
{{-   $found := false -}}
{{-   range $entries -}}
{{-     range (default (list) (get . "hooks")) -}}
{{-       if eq (get . "command") $cmd -}}
{{-         $found = true -}}
{{-         if or (ne (toJson (get . "async")) (toJson $async)) (ne (toJson (get . "timeout")) (toJson $timeout)) -}}
{{-           $_ := set . "async" $async -}}
{{-           $_ := set . "timeout" $timeout -}}
{{-           $changed = true -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if not $found -}}
{{-     $_ := set $hooks $event (append $entries $entry) -}}
{{-     $changed = true -}}
{{-   end -}}
{{- end -}}
{{- if $changed -}}
{{- $_ := set $cur "hooks" $hooks -}}
{{- toPrettyJson $cur }}
{{ else -}}
{{- .chezmoi.stdin -}}
{{- end -}}
