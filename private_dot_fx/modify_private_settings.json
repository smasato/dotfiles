{{- /* chezmoi:modify-template */ -}}
{{- /* fx writes runtime preferences to this file. Preserve them while providing
new-machine defaults and keeping binary updates under mise. */ -}}
{{- $settings := dict
      "provider" "grok"
      "permission_mode" "yolo"
      "context" true
      "models" (dict "codex" "gpt-6-astra" "grok" "grok-4.6")
      "statusLine" (dict "context" true "session" true "workspace" true)
      "prompt_history" (dict "enabled" true)
      "yolo_acknowledged" true
-}}
{{- if .chezmoi.stdin -}}
{{-   $settings = mergeOverwrite $settings (fromJson .chezmoi.stdin) -}}
{{- end -}}
{{- $enforced := dict
      "auto_upgrade" false
      "update_channel" "stable"
-}}
{{- $settings = mergeOverwrite $settings $enforced -}}
{{- $desired := toJson $settings -}}
{{- $current := "" -}}
{{- if .chezmoi.stdin -}}
{{-   $current = toJson (fromJson .chezmoi.stdin) -}}
{{- end -}}
{{- if eq $current $desired -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson $settings | trim -}}
{{- end -}}
