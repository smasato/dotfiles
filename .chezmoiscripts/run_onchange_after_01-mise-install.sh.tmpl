{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/bash

set -eu

# Install mise-managed tools first: later after-scripts (bat, skills, herdr and
# hunk integrations) invoke binaries that mise provides. after-scripts run in
# lexical order of their target name, hence the zero-padded numeric prefix.
# Reruns when the mise tool list changes.
# mise config hash: {{ includeTemplate "dot_config/mise/config.toml.tmpl" . | sha256sum }}
{{ if not .work -}}
# Probe repair hash: {{ include "dot_local/bin/executable_patch-probe.py" | sha256sum }}
{{ end -}}

export PATH="$HOME/.local/bin:/opt/homebrew/bin:${PATH}"

# Run from $HOME so only the global ~/.config/mise/config.toml applies —
# a repo-local mise.toml (e.g. the chezmoi source dir's) must not leak in.
cd "${HOME}"

# mise comes from its standalone installer rather than Homebrew, so
# `mise self-update` works. Other scripts and configs expect this path.
if [ ! -x "$HOME/.local/bin/mise" ]; then
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl -fsSL --retry 3 --connect-timeout 15 --max-time 120 https://mise.run -o "$installer"
  MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh "$installer"
  # Shims left by a Homebrew mise link to that binary; point them here instead.
  mise reshim --force
fi
{{ if not .work -}}
# Probe's pinned Git dependency is unsupported by the embedded npm installer.
# Install its prerequisites before the scoped npm override and repair hook.
mise install --yes node python ripgrep
MISE_NPM_PACKAGE_MANAGER=npm mise install --yes npm:@probelabs/probe
mise exec -- python3 "$HOME/.local/bin/patch-probe.py"
{{ end -}}
mise install --yes
{{- end }}
