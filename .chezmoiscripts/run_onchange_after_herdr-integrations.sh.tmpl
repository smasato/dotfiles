{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/bash

set -eu

# Install herdr integrations for the AI coding agents used in this environment.
# Depending on the agent, integrations report lifecycle state, resumable
# session identity, or both.
# Reruns when this list changes (e.g. when an agent is added below) or when
# the installed herdr version changes, so hooks never go stale after updates.
# agents: claude codex grok omp opencode pi
# herdr: {{ if lookPath "herdr" }}{{ output "herdr" "--version" | trim }}{{ else }}not installed{{ end }}

# Rebuild PATH from scratch: mise env prepends its tool bin dirs, and dropping
# the inherited PATH keeps stale entries (e.g. Homebrew's node) from shadowing them.
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
cd "${HOME}"
eval "$(mise env -s bash)"

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr not found on PATH; run 'mise install' first" >&2
  exit 1
fi

# The Pi and OMP integrations write extensions into these directories, while
# OpenCode writes a plugin into its config directory. Herdr requires each
# destination directory to exist beforehand.
mkdir -p "${PI_CODING_AGENT_DIR:-${HOME}/.omp/agent}/extensions"
mkdir -p "${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}/extensions"
mkdir -p "${XDG_CONFIG_HOME:-${HOME}/.config}/opencode/plugins"

for agent in claude codex grok omp opencode pi; do
  echo "Installing herdr integration: ${agent}"
  herdr integration install "${agent}"
done
{{- end }}
