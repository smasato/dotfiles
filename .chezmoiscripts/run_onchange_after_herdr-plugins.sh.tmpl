{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Refresh plugins and their agent skills when Herdr or the installer changes.
# herdr: {{ if lookPath "herdr" }}{{ output "herdr" "--version" | trim }}{{ else }}not installed{{ end }}
# installer: {{ include "dot_config/herdr/scripts/herdr_plugins.py" | sha256sum }}
# bootstrap: {{ include "dot_config/herdr/scripts/executable_update-plugins.sh" | sha256sum }}
# common: {{ include "dot_config/herdr/scripts/herdr_common.py" | sha256sum }}
set -euo pipefail
bash "$HOME/.config/herdr/scripts/update-plugins.sh"
{{- end }}
