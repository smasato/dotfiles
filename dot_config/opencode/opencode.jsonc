{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~/": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
  },

  "formatter": true,

  "compaction": {
    "auto": true,
    "prune": true,
  },

  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "**/.DS_Store"],
  },
}
