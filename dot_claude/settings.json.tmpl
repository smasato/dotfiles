{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "GIT_PAGER": "cat",
    "SHELL": "/opt/homebrew/bin/zsh"
  },
  "permissions": {
    "allow": [
      "Bash(agent-browser:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(cursor:*)",
      "Bash(docker logs:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(open:*)",
      "Bash(pueue:*)",
      "Bash(rm:*)",
      "Bash(rg:*)",
      "Read(**)",
      "EnterWorktree",
      "Bash(gh pr merge:*)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~/)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.claude/hooks/i-have-adhd-activate.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-claude-account.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {
    "catppuccin@claude-themes": true,
    "caveman@caveman": true,
    "crit@crit": true,
    "i-have-adhd@i-have-adhd": true,
    "skill-creator@claude-plugins-official": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-themes": {
      "source": {
        "source": "github",
        "repo": "matcra587/claude-themes"
      }
    },
    "cognition": {
      "source": {
        "source": "github",
        "repo": "club-cog/devin-handoff"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "language": "日本語",
  "sandbox": {
    "enabled": false,
    "network": {
      "allowUnixSockets": [
        "{{ .chezmoi.homeDir }}/Library/Application Support/pueue/pueue_*.socket"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}/Library/Caches/hk",
        "{{ .chezmoi.homeDir }}/Library/Caches/mise",
        "{{ .chezmoi.homeDir }}/.agent-browser"
      ]
    },
    "excludedCommands": [
      "git",
      "git *",
      "gh",
      "gh *",
      "mise",
      "mise *",
      "wt",
      "wt *",
      "agent-browser",
      "agent-browser *",
      "hk",
      "hk *",
      "pueue",
      "pueue *"
    ]
  },
  "effortLevel": "high",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "disableRemoteControl": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin:catppuccin-{{ if eq (get . "machineRole") "worker" }}frappe{{ else }}latte{{ end }}",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "**Internal sharing / snippet hosting**: treat public paste/gist services as outside the trust boundary",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment"
    ]
  }
}
